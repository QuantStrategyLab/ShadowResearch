  <string>com.quantstrategylab.shadow-drill</string>
  <key>Disabled</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>15</integer>
  <key>WorkingDirectory</key>
  <string>&lt;dev-home&gt;/shadow-research</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>Asia/Singapore</string>
    <key>LANG</key>
    <string>en_SG.UTF-8</string>
    <key>LC_ALL</key>
    <string>en_SG.UTF-8</string>
    <key>HTTP_PROXY</key>
    <string>http://127.0.0.1:18080</string>
    <key>HTTPS_PROXY</key>
    <string>http://127.0.0.1:18080</string>
    <key>PYTHONPATH</key>
    <string>&lt;dev-home&gt;/shadow-research/src</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>-m</string>
    <string>shadow.scheduler</string>
    <string>run-drill</string>
    <string>--session</string>
    <string>auto</string>
    <string>--require-ny-hhmm</string>
    <string>14:30,17:30</string>
    <string>--data-dir</string>
